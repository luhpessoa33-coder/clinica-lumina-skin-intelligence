name: Avisos diários do planejamento

on:
  schedule:
    - cron: "15 11 * * *"
  workflow_dispatch:

jobs:
  alertas:
    runs-on: ubuntu-latest
    steps:
      - name: Acionar checagem idempotente
        env:
          APP_URL: ${{ secrets.APP_URL }}
          CRON_SECRET: ${{ secrets.CRON_SECRET }}
        run: |
          test -n "$APP_URL" && test -n "$CRON_SECRET"
          curl --fail --silent --show-error --retry 3 \
            -X POST "$APP_URL/api/scheduled/plannerAlerts" \
            -H "Authorization: Bearer $CRON_SECRET"
