# Aplicação
NODE_ENV=development
PORT=3000
JWT_SECRET=gere-uma-frase-aleatoria-com-pelo-menos-32-caracteres
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_ALLOWLIST=seu-email@exemplo.com
ADMIN_PASSWORD_HASH='scrypt$cole-aqui-o-hash-gerado'

# PostgreSQL
DATABASE_URL=postgresql://lumina:troque-esta-senha@localhost:5432/lumina
DATABASE_SSL=false
# Em banco gerenciado, prefira true e forneça a CA quando o provedor exigir.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_CA=

# Armazenamento S3 compatível (R2, B2, AWS S3 ou MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lumina-private
S3_ACCESS_KEY_ID=troque-o-usuario
S3_SECRET_ACCESS_KEY=troque-a-senha
# Deixe vazio para links temporários assinados; use apenas se o bucket for público.
S3_PUBLIC_BASE_URL=

# Automação e avisos
CRON_SECRET=gere-outro-segredo-aleatorio
ALERT_WEBHOOK_URL=
